// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ORGANIZADOR
  CLIENTE
  PORTARIA
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum TicketStatus {
  VALID
  USED
}

enum PaymentStatus {
  APPROVED
  DECLINED
}

model Profile {
  id        String   @id @db.Uuid
  role      Role
  name      String?
  createdAt DateTime @default(now())

  organizedEvents Event[]       @relation("EventOrganizer")
  gateForEvent    Event?        @relation("EventGate")
  reservations    Reservation[] @relation("ClientReservation")

  @@map("profiles")
}

model Event {
  id             String      @id @default(uuid()) @db.Uuid
  title          String
  description    String
  place          String
  totalCapacity  Int
  stock          Int
  priceInCents   Int
  date           DateTime
  imageUrl       String?
  status         EventStatus @default(DRAFT)
  ticketmasterId String      @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organizerId String  @db.Uuid
  organizer   Profile @relation("EventOrganizer", fields: [organizerId], references: [id])

  gateProfileId String?  @unique @db.Uuid
  gateProfile   Profile? @relation("EventGate", fields: [gateProfileId], references: [id])

  reservations Reservation[] @relation("EventReservation")
  tickets      Ticket[]      @relation("EventTicket")

  @@map("events")
}

model Reservation {
  id                String            @id @default(uuid()) @db.Uuid
  quantity          Int
  unitPriceInCents  Int
  totalPriceInCents Int
  status            ReservationStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  expiresAt         DateTime?

  eventId String @db.Uuid
  event   Event  @relation("EventReservation", fields: [eventId], references: [id])

  clientId String  @db.Uuid
  client   Profile @relation("ClientReservation", fields: [clientId], references: [id])

  tickets Ticket[] @relation("ReservationTicket")
  payment Payment? @relation("ReservationPayment")

  @@map("reservations")
}

model Ticket {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  qrToken   String       @unique
  status    TicketStatus @default(VALID)
  createdAt DateTime     @default(now())
  usedAt    DateTime?

  eventId String @db.Uuid
  event   Event  @relation("EventTicket", fields: [eventId], references: [id])

  reservationId String      @db.Uuid
  reservation   Reservation @relation("ReservationTicket", fields: [reservationId], references: [id])

  @@map("tickets")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  amountInCents Int
  status        PaymentStatus
  createdAt     DateTime      @default(now())

  reservationId String      @unique @db.Uuid
  reservation   Reservation @relation("ReservationPayment", fields: [reservationId], references: [id])

  @@map("payments")
}

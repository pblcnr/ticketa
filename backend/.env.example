# Postgres connection string used at runtime (may use Supabase pooler, port 6543)
DATABASE_URL=

# Direct Postgres connection string (port 5432, not pooled) — used by Prisma CLI for migrations, separate from DATABASE_URL at runtime
DIRECT_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TICKETMASTER_API_KEY=

# Allowed CORS origin in production (e.g. deployed frontend URL). Local dev falls back to http://localhost:5173
FRONTEND_URL=

# Optional — defaults to 3000
# PORT=3000
